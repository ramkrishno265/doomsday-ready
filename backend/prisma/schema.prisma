generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id             Int      @id @default(autoincrement())
  title          String   @unique
  releaseYear    Int
  runtimeMinutes Int
  watched        Boolean  @default(false)

  prerequisites  Movie[]  @relation("MoviePrerequisites")
  dependents     Movie[]  @relation("MoviePrerequisites")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Cinema {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  bundleSizes Int[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}